# Скопируйте в .env и заполните реальными значениями.
# .env никогда не коммитится (см. .gitignore) — секреты сюда, не в код.

PORT=3000
NODE_ENV=development

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://razvit:CHANGE_ME@localhost:5432/razvit_dev

# Отдельная БД для тестов (backend/tests используют её, не dev-базу)
TEST_DATABASE_URL=postgres://razvit:CHANGE_ME@localhost:5432/razvit_test

# USDA FoodData Central — https://fdc.nal.usda.gov/api-key-signup.html
# Без ключа USDA-источник в поиске просто пропускается (не ошибка).
USDA_API_KEY=

# Open Food Facts не требует ключа, но домен настраиваемый на случай зеркала.
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
